#!/bin/bash
# Generated by roles/autodeploy_poller — do not edit on the server, edit the template.
# Deploys {{ item.app_systemd_name }} only when origin/{{ autodeploy_branch }} has moved.
set -uo pipefail

APP_DIR="{{ item.app_base_dir }}/{{ item.name }}"
BRANCH="{{ autodeploy_branch }}"
UNIT="{{ item.app_systemd_name }}"
PORT="{{ item.port }}"
DEPLOY_SCRIPT="/home/{{ app_user }}/.deploy/${UNIT}.sh"
LOCK="/tmp/autodeploy-${UNIT}.lock"

exec 9>"$LOCK"
flock -n 9 || { echo "[SKIP] $(date -Is) ${UNIT}: another run still in progress"; exit 0; }

if [ ! -d "$APP_DIR/.git" ]; then
    echo "[ERROR] $(date -Is) ${UNIT}: $APP_DIR is not a git checkout"
    exit 1
fi

sudo -u {{ app_user }} git -C "$APP_DIR" fetch origin "$BRANCH" --quiet

LOCAL="$(sudo -u {{ app_user }} git -C "$APP_DIR" rev-parse HEAD)"
REMOTE="$(sudo -u {{ app_user }} git -C "$APP_DIR" rev-parse "origin/${BRANCH}" 2>/dev/null || true)"

if [ -z "$REMOTE" ]; then
    echo "[ERROR] $(date -Is) ${UNIT}: origin/${BRANCH} not found"
    exit 1
fi

if [ "$LOCAL" = "$REMOTE" ]; then
    exit 0   # nothing new — no deploy, no restart
fi

echo "[AUTODEPLOY] $(date -Is) ${UNIT}: ${LOCAL:0:7} -> ${REMOTE:0:7}"

if ! sudo -u {{ app_user }} "$DEPLOY_SCRIPT" "$BRANCH"; then
    echo "[AUTODEPLOY FAILED] $(date -Is) ${UNIT}: deploy script exited non-zero, not restarting"
    exit 1
fi

systemctl restart "${UNIT}.service"

for _ in $(seq 1 15); do
    if curl -sf --max-time 3 "http://127.0.0.1:${PORT}/health" >/dev/null; then
        echo "[AUTODEPLOY OK] $(date -Is) ${UNIT}: healthy at ${REMOTE:0:7}"
        exit 0
    fi
    sleep 2
done

echo "[AUTODEPLOY WARNING] $(date -Is) ${UNIT}: restarted but /health didn't come up within 30s — check journalctl -u ${UNIT}"
exit 1
