# Managed by Ansible (roles/cadllm) — do not edit by hand.
# CAD_generation / FlexCAD runtime environment.

# HuggingFace access for gated Llama base weights.
HF_TOKEN={{ cadllm_hf_token }}
HUGGING_FACE_HUB_TOKEN={{ cadllm_hf_token }}
HF_HOME={{ cadllm_hf_home }}

# Model / inference defaults.
CADLLM_MODEL_NAME={{ cadllm_model_name }}
CADLLM_MODEL_PATH={{ cadllm_model_path }}
CADLLM_SERVICE_PORT={{ cadllm_service_port }}

# Geometry step runs in the conda (pythonocc) env, invoked as a subprocess by api.py.
CADLLM_GEO_PYTHON={{ cadllm_conda_install_dir }}/envs/{{ cadllm_conda_env_name }}/bin/python3
CADLLM_OUTPUT_DIR=output
CADLLM_GEO_TIMEOUT=180

# Pin to the single GPU.
CUDA_VISIBLE_DEVICES=0
